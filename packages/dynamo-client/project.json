{
  "name": "dynamo-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dynamo-client/src",
  "projectType": "library",
  "tags": [
    "type:library"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "packages/dynamo-client/**/*.ts"
        ]
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/dynamo-client",
        "main": "packages/dynamo-client/src/index.ts",
        "tsConfig": "packages/dynamo-client/tsconfig.lib.json",
        "assets": [
          "packages/dynamo-client/*.md"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/packages/dynamo-client"
      ],
      "options": {
        "jestConfig": "packages/dynamo-client/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
